# Modèle de configuration Symfony. L'entrypoint du conteneur PHP en fait une
# copie sous « .env » au premier démarrage ; ce fichier-là n'est pas versionné.
#
# Ordre de chargement, du moins au plus prioritaire :
#
#  * .env                valeurs par défaut (issues de ce modèle)
#  * .env.local          surcharges locales — c'est là que l'entrypoint écrit
#                        les secrets propres à l'installation
#  * .env.$APP_ENV       défauts versionnés spécifiques à un environnement
#  * .env.$APP_ENV.local surcharges locales spécifiques à un environnement
#
# Les vraies variables d'environnement l'emportent sur tous ces fichiers :
# sous Docker, APP_ENV, DATABASE_URL et CORS_ALLOW_ORIGIN sont injectées par
# docker/docker-compose.yml et priment donc sur les valeurs ci-dessous.
#
# AUCUN SECRET NE DOIT ÊTRE ÉCRIT ICI : ce fichier est versionné.

###> symfony/framework-bundle ###
APP_ENV=dev
# Laissé vide volontairement — généré dans .env.local par l'entrypoint.
APP_SECRET=
# URL absolue utilisée par les commandes CLI (génération de liens, sitemap…)
DEFAULT_URI=http://localhost:8000
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Valeur de repli uniquement : sous Docker, docker-compose.yml injecte la
# vraie DATABASE_URL construite depuis docker/.env, qui n'est pas versionné.
# Hors Docker, renseigner ses propres identifiants dans un fichier .env.local
# en pointant sur 127.0.0.1:3306.
DATABASE_URL="mysql://CHANGEME:CHANGEME@database:3306/llstudio?serverVersion=8.4.0-mysql&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# Origines autorisées à appeler l'API (le front Nuxt tourne sur :3000)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> lexik/jwt-authentication-bundle ###
# La paire de clés est générée au premier démarrage du conteneur et ignorée
# par git (config/jwt/*.pem).
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Laissée vide volontairement — générée dans .env.local par l'entrypoint.
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###
