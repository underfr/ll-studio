# Surcharges locales de configuration.
# Les fichiers .env versionnés (backend/.env, *.env.example) ne contiennent
# que des valeurs de développement, jamais de secret de production.
.env.local
.env.*.local
/docker/.env

# Dépendances et artefacts de build (voir aussi backend/.gitignore
# et frontend/.gitignore)
/backend/vendor/
/backend/var/
/frontend/node_modules/
/frontend/.nuxt/
/frontend/.pnpm-store/
/frontend/.output/

# IDE
/.idea/
/.vscode/

# macOS
.DS_Store
