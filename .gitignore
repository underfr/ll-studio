# Aucun fichier .env effectif n'est versionné : le dépôt ne contient que des
# modèles (*.env.example), dont l'entrypoint et l'utilisateur dérivent les
# fichiers réels. Les secrets ne peuvent donc pas partir dans un commit.
.env.local
.env.*.local
/backend/.env
/docker/.env

# Dépendances et artefacts de build (voir aussi backend/.gitignore
# et frontend/.gitignore)
/backend/vendor/
/backend/var/
/frontend/node_modules/
/frontend/.nuxt/
/frontend/.pnpm-store/
/frontend/.output/

# IDE
/.idea/
/.vscode/

# macOS
.DS_Store

# Fichiers envoyés depuis le back-office et images de fixtures copiées
/backend/public/uploads/
