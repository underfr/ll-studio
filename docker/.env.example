# Copier ce fichier en « docker/.env » puis ajuster si besoin :
#   cp docker/.env.example docker/.env
#
# Ces variables ne sont lues que par docker compose. Elles alimentent à la fois
# la configuration des conteneurs et les variables d'environnement injectées
# dans Symfony (DATABASE_URL) et Nuxt (NUXT_PUBLIC_API_BASE).

# --- Base de données MySQL ---------------------------------------------------
MYSQL_DATABASE=llstudio
MYSQL_USER=llstudio
MYSQL_PASSWORD=llstudio
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# --- Symfony -----------------------------------------------------------------
APP_ENV=dev
APP_DEBUG=1
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# --- Ports publiés sur l'hôte ------------------------------------------------
API_PORT=8000
FRONT_PORT=3000

# --- Nuxt --------------------------------------------------------------------
# Appels depuis le navigateur de l'utilisateur
NUXT_PUBLIC_API_BASE=http://localhost:8000
# Appels depuis le serveur Nuxt (SSR), en interne sur le réseau Docker
NUXT_API_BASE_SERVER=http://nginx
